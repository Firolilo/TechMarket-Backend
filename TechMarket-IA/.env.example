# Copia este archivo como .env y rellena los valores reales.

# ─── Base de datos (usadas por el perfil prod) ───────────────
TECHMARKET_IA_DB_URL=jdbc:postgresql://localhost:5432/techmarket_ia
TECHMARKET_IA_DB_USERNAME=
TECHMARKET_IA_DB_PASSWORD=

# ─── JWT ─────────────────────────────────────────────────────
# Genera un secreto seguro: openssl rand -hex 64
JWT_SECRET=
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# ─── Servidor ────────────────────────────────────────────────
SERVER_PORT=8082

# ─── Perfil activo (dev | prod) ──────────────────────────────
SPRING_PROFILES_ACTIVE=dev
